# Public URL of this backend, used by the mobile app dart-define.
PUBLIC_BASE_URL=http://localhost:8787

# Server-side OpenAI API key. Never put this into the mobile app.
OPENAI_API_KEY=sk-your-server-key

# Server-side Gemini key used only to mint short-lived Live API tokens.
# Do not put this key into the mobile application.
GEMINI_API_KEY=AIza-your-server-key
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Self-hosted LiveKit voice transport. The secret stays server-side.
LIVEKIT_URL=wss://agent.milanapremium.uz
LIVEKIT_INTERNAL_URL=ws://livekit:7880
LIVEKIT_API_KEY=replace-with-random-livekit-key
LIVEKIT_API_SECRET=replace-with-a-long-random-livekit-secret
# LiveKit Server reads the same credentials in this combined form.
LIVEKIT_KEYS="replace-with-random-livekit-key: replace-with-a-long-random-livekit-secret"

# Default model if the app does not send one.
OPENAI_MODEL=gpt-5.5

# Optional: set to a long random string in production.
SESSION_SECRET=change-me-in-production
SESSION_TTL_DAYS=30

# Required for /admin/app/update in production.
ADMIN_TOKEN=change-me-admin-token

# Private server-to-server connection. The mobile app never receives this token.
AGENTIC_OS_URL=http://172.16.10.6:8787
AGENTIC_OS_TOKEN=use-the-Agentic-OS-AUTH_TOKEN

# Keep false while ChatGPT/OpenAI account connection is disabled.
ENABLE_OPENAI_ACCOUNT=false

# SQLite database path.
DB_PATH=./data/mila.db

# Folder served by GET /downloads/<file>.
DOWNLOADS_DIR=./downloads

# Set true after connecting real billing. Then /v1/chat/stream requires an
# active subscription record for the connected account label.
REQUIRE_ACTIVE_SUBSCRIPTION=false

# Optional CORS origin. Use * for local testing.
ALLOWED_ORIGIN=*

# Optional local port.
PORT=8787

# Published host address/port used by Docker Compose. Keep the host port
# distinct from Agentic OS (8787) when both services run on the same VM.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8791
